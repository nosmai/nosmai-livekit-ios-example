.DS_Store
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Generated by `xcodegen generate` from project.yml — project.yml is the source
# of truth, so the project and its workspace are build artifacts.
*.xcodeproj/
*.xcworkspace/

# Installed by `pod install`. Podfile and Podfile.lock are tracked.
Pods/

# Optional: a Nosmai framework build unpacked locally and pointed at with
# `pod 'NosmaiCameraSDK', :path => './LocalNosmai'`. The framework binary is
# ~50 MB and is not ours to redistribute, so it stays out of the repo — the
# tracked Podfile fetches the published pod instead.
LocalNosmai/

# Bundled effect packages are yours to supply.
NosmaiLiveKitExample/Filters/*.nosmai
